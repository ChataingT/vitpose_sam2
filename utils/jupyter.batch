#!/bin/bash
#SBATCH --cpus-per-task=24
#SBATCH --job-name=jupyter
#SBATCH --chdir=/home/share/schaer2/idtracking_keypoint/utils
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --time=0-12:00:00
#SBATCH --partition=shared-gpu,private-schaer-gpu
#SBATCH --mem=32G
#SBATCH --gpus=1
#SBATCH --output=logs/slurm-%J.out
#SBATCH --mail-type=END,FAIL

echo `pwd -P`
echo `nvidia-smi -L`

# Execution parameters
PROJROOT=/home/share/schaer2/idtracking_keypoint

# Load environment
module load GCCcore/12.2.0 Python/3.10.8 cuDNN/8.9.2.26-CUDA-12.1.1
source $PROJROOT/myenv/bin/activate

jupyter notebook --no-browser --ip=0.0.0.0 --port=8900
